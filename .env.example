# Настройки для docker compose. Скопируйте в .env и поправьте.

# Публичный адрес панели — ссылки в уведомлениях и адрес для iOS-виджета
CDS_PUBLIC_URL=https://status.example.com

# За HTTPS (reverse proxy) — true
CDS_COOKIE_SECURE=true

# Порт, на котором слушает панель на хосте
CDS_HTTP_PORT=3000

# Пароль PostgreSQL (задайте свой до первого запуска)
POSTGRES_PASSWORD=change-me

# Разрешить заявки на доступ (аккаунт всё равно ждёт одобрения)
CDS_ALLOW_REGISTRATION=true
