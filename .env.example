# Настройки для docker compose. Скопируйте в .env и поправьте.

# Домен панели. A/AAAA-запись должна указывать на сервер, порты 80 и 443 открыты —
# Caddy сам выпустит и будет продлевать сертификат Let's Encrypt.
CDS_DOMAIN=status.example.com

# Пароль PostgreSQL (задайте свой до первого запуска: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# Разрешить заявки на доступ (аккаунт всё равно ждёт одобрения).
# Первый зарегистрированный становится администратором — зарегистрируйтесь сразу после запуска
# или создайте админа заранее: docker compose exec backend python -m app.cli create-admin you@mail.com Имя
CDS_ALLOW_REGISTRATION=true

# Публичный адрес (по умолчанию https://$CDS_DOMAIN) — ссылки в уведомлениях и iOS-виджет
# CDS_PUBLIC_URL=https://status.example.com
