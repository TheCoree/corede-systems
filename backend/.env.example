# Все переменные с префиксом CDS_
CDS_DATABASE_URL=sqlite+aiosqlite:///./data/corede.db
# CDS_DATABASE_URL=postgresql+asyncpg://corede:corede@localhost:5432/corede

# Публичный адрес панели (ссылки в уведомлениях, виджет)
CDS_PUBLIC_URL=http://localhost:3000

# В продакшене за HTTPS — true
CDS_COOKIE_SECURE=false

# Разрешить самостоятельную регистрацию (аккаунт всё равно ждёт одобрения)
CDS_ALLOW_REGISTRATION=true

# Запускать планировщик проверок в процессе API.
# При нескольких воркерах uvicorn — false, и отдельно `python -m app.worker`
CDS_RUN_SCHEDULER=true
CDS_SCHEDULER_CONCURRENCY=50

# Сколько дней хранить сырые проверки (почасовая статистика хранится всегда)
CDS_CHECKS_RETENTION_DAYS=14
